<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>NICE.Platform.Collaboration.ChatPlugin</RootNamespace>
    <!-- Pack as a NuGet library for distribution to host applications -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>NICE.Platform.Collaboration.ChatPlugin</PackageId>
    <Version>1.0.0</Version>
    <Description>Embeddable internal-staff chat panel for Windows applications. Drop ChatPanelControl into any WinForms app to give agents and supervisors cross-app internal messaging.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- WebView2 — Chromium-based embeddable browser, supported in WinForms / WPF / WinUI 3 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
  </ItemGroup>
</Project>
