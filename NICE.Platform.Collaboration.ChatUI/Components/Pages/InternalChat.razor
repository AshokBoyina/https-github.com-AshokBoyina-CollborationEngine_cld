@page "/chat/internal"
@layout BlankLayout
@inject IAuthService             Auth
@inject ICollaborationHubService Hub
@inject IDemoApiService          Demo
@inject NavigationManager        Nav
@inject IJSRuntime               JS
@implements IAsyncDisposable

<PageTitle>Internal Chat — NASS Collaboration</PageTitle>

<div class="nc-page">

<!-- ══ Top-bar ════════════════════════════════════════════════════════════════ -->
<div class="nc-topbar">
    <div class="nc-topbar-brand">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" style="margin-right:6px;vertical-align:middle">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
        </svg>
        NASS Collaboration
        @if (!string.IsNullOrEmpty(Auth.Current.ApplicationName))
        {
            <span style="background:rgba(255,255,255,.18);border-radius:4px;padding:2px 8px;font-size:.72rem;font-weight:600;margin-left:8px">@Auth.Current.ApplicationName</span>
        }
    </div>
    <span style="font-size:.72rem;color:rgba(255,255,255,.55);font-weight:500;letter-spacing:.04em;text-transform:uppercase">Internal Chat</span>
    <div class="nc-topbar-right" style="gap:10px">
        <span style="font-size:.82rem;color:rgba(255,255,255,.85);font-weight:500">@Auth.Current.DisplayName</span>
        <div class="nc-avatar-btn" style="background:#06b6d4" title="@Auth.Current.DisplayName">@_myInitials</div>
        @if (ViewingSession != null)
        {
            <button style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:6px;padding:4px 10px;font-size:.75rem;font-weight:600;cursor:pointer"
                    @onclick="DeselectSession">← Back to directory</button>
        }
        <button style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:6px;padding:4px 10px;font-size:.75rem;font-weight:600;cursor:pointer"
                @onclick="SignOut">Sign out</button>
    </div>
</div>

<div class="nc-body">

    <!-- ── Left sidebar: online user directory ──────────────────────────────── -->
    <div class="nc-sidebar" style="width:240px;min-width:200px">
        <div class="nc-sidebar-hd" style="display:flex;justify-content:space-between;align-items:center">
            <span>Staff online (@_users.Count)</span>
            <button style="background:none;border:none;cursor:pointer;color:var(--nice-text-muted);padding:2px 4px"
                    title="Refresh" @onclick="LoadUsersAsync">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10"/>
                    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                </svg>
            </button>
        </div>
        <div class="nc-sidebar-scroll">
            @if (_loadingUsers)
            {
                <div style="padding:20px;text-align:center;color:var(--nice-text-muted);font-size:.82rem">Loading…</div>
            }
            else if (_users.Count == 0)
            {
                <div style="padding:20px 12px;text-align:center;line-height:1.6">
                    <div style="font-size:1.3rem;margin-bottom:6px">👋</div>
                    <div style="font-weight:600;font-size:.85rem;color:var(--nice-text)">You're the first one here</div>
                    <div style="font-size:.75rem;color:var(--nice-text-muted);margin-top:4px">Other staff will appear when they connect.</div>
                </div>
            }
            else
            {
                @foreach (var u in _users)
                {
                    var uidStr    = u.UserId.ToString();
                    var session   = _sessions.FirstOrDefault(s => s.PeerId == uidStr);
                    var isViewing = _viewingPeerId == uidStr;
                    var isWaiting = session?.State == SessState.Waiting;
                    var isActive  = session?.State == SessState.Active;

                    <div class="nc-list-item @(isViewing ? "nc-list-item--active" : "")"
                         style="padding:10px 12px;cursor:pointer"
                         @onclick="() => SelectUser(u)">
                        <div style="position:relative;flex-shrink:0">
                            <div class="nc-item-av" style="background:@UserTypeColor(u.UserType);width:34px;height:34px;font-size:.8rem">
                                @Initials(u.DisplayName)
                            </div>
                            <span style="position:absolute;bottom:0;right:0;width:9px;height:9px;background:#22c55e;border-radius:50%;border:2px solid var(--nice-bg,#f8fafc)"></span>
                        </div>
                        <div class="nc-item-body" style="min-width:0">
                            <div class="nc-item-name" style="font-size:.84rem">@u.DisplayName</div>
                            <div style="display:flex;align-items:center;gap:4px;margin-top:2px">
                                <span style="display:inline-block;padding:1px 6px;border-radius:10px;font-size:.65rem;font-weight:600;letter-spacing:.03em;
                                             background:@UserTypeBadgeBg(u.UserType);color:@UserTypeBadgeColor(u.UserType)">
                                    @u.UserType
                                </span>
                                @if (isWaiting)
                                {
                                    <span style="font-size:.65rem;color:#f59e0b;font-weight:600">● waiting…</span>
                                }
                                else if (isActive)
                                {
                                    <span style="font-size:.65rem;color:#22c55e;font-weight:600">● active</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- ── Centre / main panel ──────────────────────────────────────────────── -->
    <!-- Use @key so Blazor fully re-renders the panel when the viewed session changes -->
    <div class="nc-center" style="display:flex;flex-direction:column;min-width:0" @key="_viewingPeerId">
    @{
        var vs = ViewingSession;
    }

        @if (vs == null)
        {
            <!-- No conversation selected -->
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--nice-text-muted);gap:10px">
                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity=".35">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <div style="font-size:.88rem">
                    @if (_users.Count == 0) { <span>No other staff online right now.</span> }
                    else { <span>Select a person on the left to start a direct chat.</span> }
                </div>
            </div>
        }
        else if (vs.State == SessState.Waiting)
        {
            <!-- Waiting for the other person to accept -->
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px">
                <div style="width:56px;height:56px;border-radius:50%;border:3px solid #e2e8f0;border-top-color:#06b6d4;animation:spin .8s linear infinite"></div>
                <div style="text-align:center">
                    <div style="font-weight:700;font-size:.95rem;color:var(--nice-text);margin-bottom:4px">
                        Waiting for @vs.PeerName to accept…
                    </div>
                    <div style="font-size:.78rem;color:var(--nice-text-muted)">
                        They'll get a private accept/decline popup.
                    </div>
                </div>
                <button style="margin-top:4px;background:none;border:1px solid #e2e8f0;border-radius:6px;padding:6px 16px;font-size:.78rem;color:var(--nice-text-muted);cursor:pointer"
                        @onclick="() => CancelRequest(vs)">Cancel request</button>
            </div>
        }
        else if (vs.State == SessState.Declined)
        {
            <!-- Request was declined -->
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px">
                <div style="font-size:2rem">🙅</div>
                <div style="font-weight:700;font-size:.95rem;color:var(--nice-text)">@vs.PeerName declined your request</div>
                <button class="btn btn--primary" style="margin-top:4px" @onclick="() => RemoveSession(vs)">Back to directory</button>
            </div>
        }
        else if (vs.State == SessState.Active)
        {
            <!-- Active direct chat -->
            <!-- Chat header -->
            <div class="nc-session-hd">
                <div class="nc-session-title">
                    <div class="nc-item-av" style="background:@UserTypeColor(vs.PeerUserType);width:30px;height:30px;font-size:.74rem">
                        @Initials(vs.PeerName)
                    </div>
                    <div>
                        <span style="font-weight:600;font-size:.9rem">@vs.PeerName</span>
                        <span style="display:inline-block;margin-left:6px;padding:1px 7px;border-radius:10px;font-size:.65rem;font-weight:600;
                                     background:@UserTypeBadgeBg(vs.PeerUserType);color:@UserTypeBadgeColor(vs.PeerUserType)">
                            @vs.PeerUserType
                        </span>
                    </div>
                </div>
                <div class="nc-session-actions">
                    <button class="btn btn--danger" style="padding:5px 14px;font-size:.8rem" @onclick="() => EndChat(vs)">End chat</button>
                </div>
            </div>

            <!-- Messages -->
            <div class="nc-chat" id="ic-chat-scroll">
                @if (vs.Messages.Count == 0)
                {
                    <div style="text-align:center;color:var(--nice-text-muted);font-size:.82rem;margin-top:32px">
                        Say hello to @vs.PeerName 👋
                    </div>
                }
                @foreach (var m in vs.Messages)
                {
                    var isOwn = m.SenderId == _myUserId;
                    @if (isOwn)
                    {
                        <div class="nc-msg-row nc-msg-row--user">
                            <div class="nc-bubble nc-bubble--user">@m.Content</div>
                            <span class="nc-msg-time">@m.SentAt.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                    }
                    else
                    {
                        <div class="nc-msg-row nc-msg-row--bot">
                            <div class="nc-item-av" style="background:@UserTypeColor(vs.PeerUserType);width:26px;height:26px;font-size:.65rem;flex-shrink:0;align-self:flex-end">
                                @Initials(m.SenderName)
                            </div>
                            <div>
                                <div class="nc-bubble nc-bubble--bot">
                                    <span style="font-size:.62rem;font-weight:600;opacity:.7;display:block;margin-bottom:2px">@m.SenderName</span>
                                    @m.Content
                                </div>
                                <span class="nc-msg-time">@m.SentAt.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Input -->
            <div class="nc-input-bar">
                <textarea class="nc-input" rows="1"
                          placeholder="Message @vs.PeerName…"
                          @bind="vs.Draft"
                          @bind:event="oninput"
                          @onkeydown="@(e => OnInputKeyDown(e, vs))"
                          @ref="_inputRef"
                          disabled="@_sending"></textarea>
                <button class="nc-send-btn" @onclick="() => SendMessage(vs)"
                        disabled="@(string.IsNullOrWhiteSpace(vs.Draft) || _sending)">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                        <path d="M2 10l16-8-8 16V11L2 10z" fill="white"/>
                    </svg>
                </button>
            </div>
        }
    </div>

</div><!-- end nc-body -->

<!-- ── Incoming DM popup (another Internal staff pinging this user) ────────── -->
<!-- Placed bottom-right; z-index 500 sits above everything on this page.      -->
@if (_showIncomingRequest)
{
    <div style="position:fixed;bottom:24px;right:24px;z-index:500;background:#fff;border:1.5px solid #06b6d4;
                border-radius:var(--radius-lg);padding:1.25rem;width:300px;
                box-shadow:0 12px 40px rgba(6,182,212,.25);animation:cw-in .28s cubic-bezier(.34,1.56,.64,1)">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
            <div class="nc-item-av" style="background:#06b6d4;width:38px;height:38px">
                @Initials(_incomingFromName)
            </div>
            <div>
                <div style="font-weight:700;font-size:.9rem">Internal chat request</div>
                <div style="font-size:.75rem;color:var(--nice-text-muted)">
                    <span style="display:inline-block;padding:1px 6px;border-radius:10px;font-size:.65rem;font-weight:600;
                                 background:#ecfeff;color:#0891b2;margin-right:4px">@_incomingFromUserType</span>
                    @_incomingFromName wants to chat
                </div>
            </div>
        </div>
        <div style="display:flex;gap:8px">
            <button class="btn btn--primary" style="flex:1;background:#06b6d4;border-color:#06b6d4"
                    @onclick="AcceptIncomingDirectChat">Accept</button>
            <button class="btn btn--danger" style="flex:1"
                    @onclick="DeclineIncomingDirectChat">Decline</button>
        </div>
    </div>
}

</div><!-- end nc-page -->

@code {
    // ── Per-session state ──────────────────────────────────────────────────
    enum SessState { Waiting, Active, Declined }

    sealed class InternalDmSession
    {
        public string   PeerId       { get; set; } = string.Empty;
        public string   PeerName     { get; set; } = string.Empty;
        public string   PeerUserType { get; set; } = string.Empty;
        public string   CollabId     { get; set; } = string.Empty;
        public SessState State       { get; set; } = SessState.Waiting;
        public List<ChatMessage> Messages { get; } = new();
        public string   Draft        { get; set; } = string.Empty;
        public DateTime StartedAt    { get; }      = DateTime.UtcNow;
    }

    // ── Page-level state ───────────────────────────────────────────────────
    List<InternalDmSession> _sessions      = new();
    string                  _viewingPeerId = string.Empty;
    string                  _pendingPeerId = string.Empty;   // routes OnCollaborationCreated

    /// <summary>Returns the session currently shown in the main panel (null = directory).</summary>
    InternalDmSession? ViewingSession =>
        string.IsNullOrEmpty(_viewingPeerId) ? null :
        _sessions.FirstOrDefault(s => s.PeerId == _viewingPeerId);

    // ── Auth / identity ────────────────────────────────────────────────────
    string _myUserId   = string.Empty;
    string _myInitials = "IN";

    // ── Directory ──────────────────────────────────────────────────────────
    List<OnlineUserInfo> _users        = new();
    bool                 _loadingUsers = true;

    // ── Input helpers (page-level; only one panel visible at a time) ───────
    bool             _sending  = false;
    ElementReference _inputRef;

    // ── Incoming DM request ────────────────────────────────────────────────
    bool   _showIncomingRequest  = false;
    string _incomingCollabId     = string.Empty;
    string _incomingFromName     = string.Empty;
    string _incomingFromUserType = string.Empty;

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.Current.IsAuthenticated) { Nav.NavigateTo("/login", replace: true); return; }

        _myUserId   = Auth.Current.UserId;
        _myInitials = Initials(Auth.Current.DisplayName);

        Hub.OnOnlineUsersUpdated         += OnOnlineUsersUpdated;
        Hub.OnMessageReceived            += OnMessageReceived;
        Hub.OnCollaborationCreated       += OnCollaborationCreated;
        Hub.OnCollaborationAccepted      += OnCollaborationAccepted;
        Hub.OnCollaborationEnded         += OnCollaborationEnded;
        Hub.OnConnectionChanged          += OnConnectionChanged;
        Hub.OnInternalDirectChatReceived += OnIncomingDirectChat;

        if (Hub.ConnectionState != HubConnectionState.Connected)
        {
            try { await Hub.ConnectAsync(); }
            catch (Exception ex) { Console.WriteLine($"[InternalChat] Hub connect failed: {ex.Message}"); }
        }

        await LoadUsersAsync();
    }

    public async ValueTask DisposeAsync()
    {
        Hub.OnOnlineUsersUpdated         -= OnOnlineUsersUpdated;
        Hub.OnMessageReceived            -= OnMessageReceived;
        Hub.OnCollaborationCreated       -= OnCollaborationCreated;
        Hub.OnCollaborationAccepted      -= OnCollaborationAccepted;
        Hub.OnCollaborationEnded         -= OnCollaborationEnded;
        Hub.OnConnectionChanged          -= OnConnectionChanged;
        Hub.OnInternalDirectChatReceived -= OnIncomingDirectChat;

        // Leave every open session cleanly (don't End — the other side keeps their copy)
        foreach (var s in _sessions.ToList())
        {
            if (!string.IsNullOrEmpty(s.CollabId))
            {
                try { await Hub.LeaveCollaborationAsync(s.CollabId); } catch { }
            }
        }
    }

    async Task LoadUsersAsync()
    {
        _loadingUsers = true;
        StateHasChanged();
        var appId = Guid.TryParse(Auth.Current.ApplicationId, out var g) ? g : Guid.Empty;
        var raw   = await Demo.GetOnlineUsersAsync(appId);
        // Show all non-External staff except self
        _users = raw
            .Where(u => u.UserId.ToString() != _myUserId)
            .OrderBy(u => u.UserType)
            .ThenBy(u => u.DisplayName)
            .ToList();
        _loadingUsers = false;
        StateHasChanged();
    }

    // ── Hub handlers ───────────────────────────────────────────────────────
    async Task OnOnlineUsersUpdated(List<OnlineUserInfo> users)
    {
        _users = users
            .Where(u => u.UserId.ToString() != _myUserId)
            .OrderBy(u => u.UserType)
            .ThenBy(u => u.DisplayName)
            .ToList();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Server confirmed the collaboration was created — attach the CollabId to the pending session.</summary>
    Task OnCollaborationCreated(string collabId, string status)
    {
        var session = _sessions.FirstOrDefault(s => s.PeerId == _pendingPeerId);
        if (session != null)
        {
            session.CollabId = collabId;
            session.State    = SessState.Waiting;
            _ = Hub.JoinCollaborationAsync(collabId);
        }
        _pendingPeerId = string.Empty;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>The other person accepted — mark session active.</summary>
    Task OnCollaborationAccepted(string collabId, string status, string agentName)
    {
        var session = _sessions.FirstOrDefault(s => s.CollabId == collabId);
        if (session != null)
        {
            session.State = SessState.Active;
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    /// <summary>
    /// The other side ended/declined the session.
    /// If Waiting → mark Declined.  If Active → remove the session.
    /// </summary>
    Task OnCollaborationEnded(string collabId)
    {
        var session = _sessions.FirstOrDefault(s => s.CollabId == collabId);
        if (session == null) return Task.CompletedTask;

        if (session.State == SessState.Waiting)
        {
            session.State = SessState.Declined;
        }
        else
        {
            // Ended by the other side while active — drop it
            if (_viewingPeerId == session.PeerId)
                _viewingPeerId = string.Empty;
            _sessions.Remove(session);
        }
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>Route incoming messages to the correct session by CollabId.</summary>
    Task OnMessageReceived(ChatMessage msg)
    {
        var session = _sessions.FirstOrDefault(s => s.CollabId == msg.CollaborationId);
        if (session == null || session.State != SessState.Active) return Task.CompletedTask;
        if (msg.SenderId == _myUserId) return Task.CompletedTask;   // skip own echo

        session.Messages.Add(msg);
        return InvokeAsync(async () =>
        {
            StateHasChanged();
            // Only auto-scroll if this session is the one currently on screen
            if (_viewingPeerId == session.PeerId)
            {
                try { await JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "ic-chat-scroll"); } catch { }
            }
        });
    }

    void OnConnectionChanged() => InvokeAsync(StateHasChanged);

    // ── Actions ────────────────────────────────────────────────────────────
    /// <summary>
    /// Sidebar click: switch view if a session already exists, otherwise create
    /// a new session and request the collaboration.
    /// </summary>
    void SelectUser(OnlineUserInfo user)
    {
        if (user.UserId.ToString() == _myUserId) return;
        var uidStr = user.UserId.ToString();

        var existing = _sessions.FirstOrDefault(s => s.PeerId == uidStr);
        if (existing != null)
        {
            // Switch the main panel to show this existing session
            _viewingPeerId = uidStr;
            StateHasChanged();
            return;
        }

        // No session yet — create one and send the request
        var newSession = new InternalDmSession
        {
            PeerId       = uidStr,
            PeerName     = user.DisplayName,
            PeerUserType = user.UserType
        };
        _sessions.Add(newSession);
        _viewingPeerId = uidStr;
        _pendingPeerId = uidStr;   // OnCollaborationCreated will look up by this
        StateHasChanged();

        _ = RequestChatAsync(uidStr);
    }

    async Task RequestChatAsync(string targetUserId)
    {
        try { await Hub.RequestCollaborationAsync(targetUserId); }
        catch (Exception ex) { Console.WriteLine($"[InternalChat] RequestCollaboration error: {ex.Message}"); }
    }

    /// <summary>Cancel an outgoing pending request and remove the session.</summary>
    async Task CancelRequest(InternalDmSession session)
    {
        var collabId = session.CollabId;
        RemoveSession(session);
        if (!string.IsNullOrEmpty(collabId))
        {
            try { await Hub.EndCollaborationAsync(collabId); } catch { }
            try { await Hub.LeaveCollaborationAsync(collabId); } catch { }
        }
    }

    /// <summary>Explicitly end an active session (user clicked "End chat").</summary>
    async Task EndChat(InternalDmSession session)
    {
        var collabId = session.CollabId;    // capture before removing — OnCollaborationEnded
        RemoveSession(session);             // will try to look up the session by collabId
        if (!string.IsNullOrEmpty(collabId))
        {
            try { await Hub.EndCollaborationAsync(collabId); } catch { }
            try { await Hub.LeaveCollaborationAsync(collabId); } catch { }
        }
    }

    /// <summary>Just deselect the main panel without ending any session.</summary>
    void DeselectSession()
    {
        _viewingPeerId = string.Empty;
        StateHasChanged();
    }

    /// <summary>Remove a session from the list and clear the view if it was selected.</summary>
    void RemoveSession(InternalDmSession session)
    {
        if (_viewingPeerId == session.PeerId)
            _viewingPeerId = string.Empty;
        _sessions.Remove(session);
        StateHasChanged();
    }

    async Task SendMessage(InternalDmSession session)
    {
        var text = session.Draft.Trim();
        if (string.IsNullOrWhiteSpace(text) || _sending || string.IsNullOrEmpty(session.CollabId)) return;

        session.Draft = string.Empty;
        _sending      = true;

        // Optimistic local echo
        session.Messages.Add(new ChatMessage
        {
            CollaborationId = session.CollabId,
            SenderId        = _myUserId,
            SenderName      = Auth.Current.DisplayName,
            SenderRole      = "Internal",
            Content         = text,
            IsMine          = true,
            SentAt          = DateTime.UtcNow
        });
        StateHasChanged();

        try { await Hub.SendMessageAsync(session.CollabId, text); }
        catch (Exception ex) { Console.WriteLine($"[InternalChat] SendMessage error: {ex.Message}"); }

        _sending = false;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("chatHelpers.scrollToBottom", "ic-chat-scroll"); } catch { }
        try { await _inputRef.FocusAsync(); } catch { }
    }

    async Task OnInputKeyDown(KeyboardEventArgs e, InternalDmSession session)
    {
        if (e.Key == "Enter" && !e.ShiftKey) await SendMessage(session);
    }

    async Task SignOut()
    {
        // End all open sessions before leaving
        foreach (var s in _sessions.ToList())
        {
            var cid = s.CollabId;
            if (!string.IsNullOrEmpty(cid))
            {
                try { await Hub.EndCollaborationAsync(cid); } catch { }
            }
        }
        try { await Hub.DisconnectAsync(); } catch { }
        Nav.NavigateTo("/login");
    }

    // ── Incoming DM (another Internal staff pinging this user) ─────────────
    Task OnIncomingDirectChat(string collabId, string senderName, string senderUserType)
        => InvokeAsync(() =>
        {
            _incomingCollabId     = collabId;
            _incomingFromName     = senderName;
            _incomingFromUserType = senderUserType;
            _showIncomingRequest  = true;
            StateHasChanged();
        });

    async Task AcceptIncomingDirectChat()
    {
        _showIncomingRequest = false;

        // Try to match the sender to a known user by display name so we can key by userId
        var senderUser = _users.FirstOrDefault(u =>
            string.Equals(u.DisplayName, _incomingFromName, StringComparison.OrdinalIgnoreCase));
        // Fallback: use the collabId itself as the peer key (no userId known)
        var peerId = senderUser?.UserId.ToString() ?? _incomingCollabId;

        // If we already have a session for this peer (e.g. we also sent them a request simultaneously),
        // update it rather than creating a duplicate.
        var existing = _sessions.FirstOrDefault(s =>
            s.PeerId == peerId || s.CollabId == _incomingCollabId);
        if (existing != null)
        {
            existing.CollabId = _incomingCollabId;
            existing.State    = SessState.Active;
            _viewingPeerId    = existing.PeerId;
        }
        else
        {
            var newSession = new InternalDmSession
            {
                PeerId       = peerId,
                PeerName     = _incomingFromName,
                PeerUserType = _incomingFromUserType,
                CollabId     = _incomingCollabId,
                State        = SessState.Active
            };
            _sessions.Add(newSession);
            _viewingPeerId = peerId;
        }

        StateHasChanged();

        try { await Hub.JoinCollaborationAsync(_incomingCollabId); } catch { }
        try { await Hub.AcceptCollaborationAsync(_incomingCollabId); } catch { }
    }

    async Task DeclineIncomingDirectChat()
    {
        _showIncomingRequest = false;
        StateHasChanged();
        try { await Hub.EndCollaborationAsync(_incomingCollabId); } catch { }
    }

    // ── Style helpers ──────────────────────────────────────────────────────
    static string UserTypeColor(string userType) => userType switch
    {
        "Agent"      => "#3b82f6",
        "Supervisor" => "#7c3aed",
        "Internal"   => "#06b6d4",
        _            => "#6b7280"
    };

    static string UserTypeBadgeBg(string userType) => userType switch
    {
        "Agent"      => "#eff6ff",
        "Supervisor" => "#f5f3ff",
        "Internal"   => "#ecfeff",
        _            => "#f3f4f6"
    };

    static string UserTypeBadgeColor(string userType) => userType switch
    {
        "Agent"      => "#1d4ed8",
        "Supervisor" => "#6d28d9",
        "Internal"   => "#0891b2",
        _            => "#374151"
    };

    static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
            : name.Length > 0 ? name[0].ToString().ToUpperInvariant() : "?";
    }
}
