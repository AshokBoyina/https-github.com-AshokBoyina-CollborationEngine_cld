{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=NICECollaborationEngine;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_256BIT_SECRET_MIN_32_CHARS",
    "Issuer": "NICE.Platform.Collaboration",
    "Audience": "NICE.Platform.Collaboration.Clients",
    "ExpiryMinutes": 60,
    "ExpiryMinutesExternal": 30
  },
  "Azure": {
    "SignalR": {
      "ConnectionString": "REPLACE_WITH_AZURE_SIGNALR_CONNECTION_STRING"
    },
    "BlobStorage": {
      "ConnectionString": "REPLACE_WITH_BLOB_STORAGE_CONNECTION_STRING",
      "ContainerName": "collaborations"
    }
  },
  "TurnServer": {
    "Urls": [ "turn:your-turn-server.com:3478", "stun:your-turn-server.com:3478" ],
    "Username": "REPLACE",
    "Credential": "REPLACE"
  },
  "BotService": {
    "Endpoint": "REPLACE_WITH_AZURE_AI_FOUNDRY_ENDPOINT",
    "ApiKey": "REPLACE"
  },
  "AuthValidation": {
    "UseMock": false,
    "Endpoints": {
      "ReadiValidateUrl": "https://readi.example.com/api/validate",
      "NiceValidateUrl": "https://nice.example.com/api/validate"
    },
    "Mock": {
      "Readi": {
        "IsValid": true,
        "UserId": "readi-mock-user-001",
        "Email": "agent@readi.mock.com",
        "FirstName": "Readi",
        "LastName": "MockAgent"
      },
      "Nice": {
        "IsValid": true,
        "UserId": "nice-mock-user-001",
        "Email": "agent@nice.mock.com",
        "FirstName": "Nice",
        "LastName": "MockAgent"
      },
      "Anon": {
        "IsValid": true,
        "UserId": "anon-mock-user-001",
        "Email": "anon@mock.com",
        "FirstName": "Anonymous",
        "LastName": "User",
        "SurveyId": "mock-survey-999"
      }
    }
  },
  "Applications": {
    "SurveyPortal": {
      "AuthProvider": "ANON",
      "External": {
        "ChatMode": "BotThenHuman",
        "CanShareScreen": true,
        "NeedScreenRecording": false
      },
      "Internal": {
        "ChatMode": "TalkWithAvailableAgent",
        "CanShareScreen": true,
        "NeedScreenRecording": false
      },
      "Agent": {
        "CanHandOffToOtherAgent": true,
        "MaxParallelChats": 5
      },
      "Supervisor": {
        "MaxParallelChats": 10,
        "CanHandOffToOtherAgent": false
      },
      "StandAlone": {
        "AutoRecordScreen": true,
        "SupervisorCanWatchLive": false
      }
    },
    "CustomerSupport": {
      "AuthProvider": "READI",
      "External": {
        "ChatMode": "BotThenHuman",
        "CanShareScreen": true,
        "NeedScreenRecording": true
      },
      "Internal": {
        "ChatMode": "TalkWithAvailableAgent",
        "CanShareScreen": true,
        "NeedScreenRecording": false
      },
      "Agent": {
        "CanHandOffToOtherAgent": true,
        "MaxParallelChats": 8
      },
      "Supervisor": {
        "MaxParallelChats": 15,
        "CanHandOffToOtherAgent": true
      },
      "StandAlone": {
        "AutoRecordScreen": false,
        "SupervisorCanWatchLive": true
      }
    },
    "NicePortal": {
      "AuthProvider": "NICE",
      "External": {
        "ChatMode": "OnlyHuman",
        "CanShareScreen": false,
        "NeedScreenRecording": false
      },
      "Internal": {
        "ChatMode": "TalkWithAvailableAgent",
        "CanShareScreen": true,
        "NeedScreenRecording": true
      },
      "Agent": {
        "CanHandOffToOtherAgent": false,
        "MaxParallelChats": 3
      },
      "Supervisor": {
        "MaxParallelChats": 20,
        "CanHandOffToOtherAgent": false
      },
      "StandAlone": {
        "AutoRecordScreen": true,
        "SupervisorCanWatchLive": true
      }
    }
  },
  "AuthProviders": {
    "Readi": {
      "Secret": "REPLACE_WITH_READI_SHARED_SECRET",
      "Issuer": "REPLACE_WITH_READI_ISSUER",
      "Audience": "REPLACE_WITH_READI_AUDIENCE",
      "ApplicationId": "00000000-0000-0000-0000-000000000001",
      "ValidateAudience": true
    },
    "Nice": {
      "Authority": "https://login.nice.example.com",
      "Issuer": "https://login.nice.example.com/v2.0",
      "Audience": "nice-collaboration-api",
      "ApplicationId": "00000000-0000-0000-0000-000000000002",
      "ValidateAudience": true
    }
  }
}
