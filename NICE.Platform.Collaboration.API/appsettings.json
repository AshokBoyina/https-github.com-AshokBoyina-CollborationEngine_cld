{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning" } }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=NICECollaborationEngine;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;"
  },

  // ── Feature flags — flip to true when ready to migrate to Azure ────────────
  // All default to false → local/free path is used until you are ready.
  "FeatureFlags": {
    "UseMockAuth":     true,
    "UseAzureSignalR": false,
    "UseAzureBlob":    false,
    "UseCustomTurn":   false,
    // Set to true once BotApi credentials below are filled in.
    // false → UI keyword-mock in ExternalChat.razor handles bot replies (no API call).
    "UseRealBot":      false
  },

  // ── JWT issued by this API ─────────────────────────────────────────────────
  // Key/Issuer/Audience MUST match AuthValidation:LocalJwt:* so that tokens
  // minted by /api/v1/demo/mint-token pass the [Authorize] bearer-token check
  // on controllers such as RecordingsController.  In LOCAL_JWT mode this API
  // both issues and validates the tokens, so the secrets are the same.
  "Jwt": {
    "Key":                    "NICE-Collaboration-LocalJwt-Secret-Key-2024!",
    "Issuer":                 "NICE.Collaboration.Local",
    "Audience":               "NICE.Collaboration.Api",
    "ExpiryMinutes":          60,
    "ExpiryMinutesExternal":  30
  },

  // ── Local file storage (UseAzureBlob = false) ──────────────────────────────
  "LocalStorage": {
    "RecordingsPath":  "C:\\Users\\ashok\\CascadeProjects\\CollaborationEngine_Cld\\NICE.Platform.Collaboration\\Recordings",
    "AttachmentsPath": "C:\\Users\\ashok\\CascadeProjects\\CollaborationEngine_Cld\\NICE.Platform.Collaboration\\Attachments"
  },

  // ── WebRTC ICE servers (UseCustomTurn = false → Google free STUN) ──────────
  "IceServers": {
    "GoogleStun": [
      "stun:stun.l.google.com:19302",
      "stun:stun1.l.google.com:19302"
    ]
  },

  // ── Azure — only needed when the matching flag is true ─────────────────────
  "Azure": {
    "SignalR": {
      "ConnectionString": "REPLACE_WITH_AZURE_SIGNALR_CONNECTION_STRING"
    },
    "BlobStorage": {
      "ConnectionString": "REPLACE_WITH_BLOB_STORAGE_CONNECTION_STRING",
      "ContainerName":    "collaborations"
    }
  },

  // ── TURN server — only needed when UseCustomTurn = true ───────────────────
  "TurnServer": {
    "Urls":       [ "turn:your-turn-server.com:3478", "stun:your-turn-server.com:3478" ],
    "Username":   "REPLACE",
    "Credential": "REPLACE"
  },

  // ── Bot API — real bot integration (FeatureFlags:UseRealBot = true) ──────────
  // ApiKey and ApiAccessKey are NOT stored here — they are entered on the login
  // screen and flow through the user session per-call, so no restart is required
  // when credentials change. Only BaseUrl, ChatPath, and TimeoutSeconds live here.
  "BotApi": {
    "BaseUrl":        "https://your-api-host.example.com",
    "ChatPath":       "/v1/AI/Bot/chat",
    "TimeoutSeconds": 30
  },

  // ── Auth validation ────────────────────────────────────────────────────────
  // UseMock: false → LOCAL_JWT mode: tokens are HMAC-SHA256 signed with LocalJwt:Secret.
  // Mint tokens via:  POST /api/v1/demo/mint-token?name=Alice+Smith&role=Agent
  // Switch to true   → bypasses all signature checks (dev/demo rapid iteration only).
  "AuthValidation": {
    "UseMock": false,
    "Endpoints": {
      "ReadiValidateUrl": "https://readi.example.com/api/validate",
      "NiceValidateUrl":  "https://nice.example.com/api/validate"
    },
    // ── LOCAL_JWT signing secret ─────────────────────────────────────────────
    // Must be ≥ 32 characters. Override via environment variable in CI/staging:
    //   AuthValidation__LocalJwt__Secret=<your-secret>
    "LocalJwt": {
      "Secret":         "NICE-Collaboration-LocalJwt-Secret-Key-2024!",
      "Issuer":         "NICE.Collaboration.Local",
      "Audience":       "NICE.Collaboration.Api",
      "ValidateExpiry": true
    },
    // ── Mock block — only used when UseMock: true ────────────────────────────
    "Mock": {
      "Readi": {
        "IsValid":    true,
        "UserId":     "readi-mock-user-001",
        "Email":      "agent@readi.mock.com",
        "FirstName":  "Readi",
        "LastName":   "MockAgent"
      },
      "Nice": {
        "IsValid":    true,
        "UserId":     "nice-mock-user-001",
        "Email":      "agent@nice.mock.com",
        "FirstName":  "Nice",
        "LastName":   "MockAgent"
      },
      "Anon": {
        "IsValid":    true,
        "UserId":     "anon-mock-user-001",
        "Email":      "anon@mock.com",
        "FirstName":  "Anonymous",
        "LastName":   "User",
        "SurveyId":   "mock-survey-999"
      }
    }
  },

  // ── Application configurations ─────────────────────────────────────────────
  // StaffAuthProvider: used for Agent, Supervisor, Internal, StandAlone users.
  // External users always use ANON auth — StaffAuthProvider is ignored for them.
  "Applications": {
    "SurveyPortal": {
      "StaffAuthProvider": "LOCAL_JWT",
      "External": {
        "ChatMode":           "BotThenHuman",
        "CanShareScreen":     true,
        "NeedScreenRecording": false
      },
      "Internal": {
        "ChatMode":           "TalkWithAvailableAgent",
        "CanShareScreen":     true,
        "NeedScreenRecording": false
      },
      "Agent": {
        "CanHandOffToOtherAgent": true,
        "MaxParallelChats":      5
      },
      "Supervisor": {
        "MaxParallelChats":      10,
        "CanHandOffToOtherAgent": false
      },
      "StandAlone": {
        "AutoRecordScreen":      true,
        "SupervisorCanWatchLive": false
      }
    },
    "Readi": {
      "StaffAuthProvider": "LOCAL_JWT",
      "External": {
        "ChatMode":           "BotThenHuman",
        "CanShareScreen":     true,
        "NeedScreenRecording": true
      },
      "Internal": {
        "ChatMode":           "TalkWithAvailableAgent",
        "CanShareScreen":     true,
        "NeedScreenRecording": false
      },
      "Agent": {
        "CanHandOffToOtherAgent": true,
        "MaxParallelChats":      8
      },
      "Supervisor": {
        "MaxParallelChats":      15,
        "CanHandOffToOtherAgent": true
      },
      "StandAlone": {
        "AutoRecordScreen":      false,
        "SupervisorCanWatchLive": true
      }
    },
    "NicePortal": {
      "StaffAuthProvider": "LOCAL_JWT",
      "External": {
        "ChatMode":           "OnlyHuman",
        "CanShareScreen":     false,
        "NeedScreenRecording": false
      },
      "Internal": {
        "ChatMode":           "TalkWithAvailableAgent",
        "CanShareScreen":     true,
        "NeedScreenRecording": true
      },
      "Agent": {
        "CanHandOffToOtherAgent": false,
        "MaxParallelChats":      3
      },
      "Supervisor": {
        "MaxParallelChats":      20,
        "CanHandOffToOtherAgent": false
      },
      "StandAlone": {
        "AutoRecordScreen":      true,
        "SupervisorCanWatchLive": true
      }
    }
  },

  // ── External auth providers (real tokens from READI / NICE) ───────────────
  "AuthProviders": {
    "Readi": {
      "Secret":          "REPLACE_WITH_READI_SHARED_SECRET",
      "Issuer":          "REPLACE_WITH_READI_ISSUER",
      "Audience":        "REPLACE_WITH_READI_AUDIENCE",
      "ApplicationId":   "00000000-0000-0000-0000-000000000001",
      "ValidateAudience": true
    },
    "Nice": {
      "Authority":       "https://login.nice.example.com",
      "Issuer":          "https://login.nice.example.com/v2.0",
      "Audience":        "nice-collaboration-api",
      "ApplicationId":   "00000000-0000-0000-0000-000000000002",
      "ValidateAudience": true
    }
  }
}
