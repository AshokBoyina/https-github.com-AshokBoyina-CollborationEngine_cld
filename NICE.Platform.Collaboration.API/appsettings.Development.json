{
  "Serilog": {
    "MinimumLevel": { "Default": "Debug", "Override": { "Microsoft": "Information" } }
  },
  "Jwt": {
    "Key": "dev-local-secret-key-minimum-32-characters",
    "Issuer": "NICE.Platform.Collaboration",
    "Audience": "NICE.Platform.Collaboration.Clients",
    "ExpiryMinutes": 120,
    "ExpiryMinutesExternal": 60
  },
  "AuthValidation": {
    "UseMock": true,
    "Endpoints": {
      "ReadiValidateUrl": "https://readi-dev.example.com/api/validate",
      "NiceValidateUrl": "https://nice-dev.example.com/api/validate"
    },
    "Mock": {
      "Readi": {
        "IsValid": true,
        "UserId": "readi-dev-user-001",
        "Email": "dev.agent@readi.com",
        "FirstName": "Dev",
        "LastName": "ReadiAgent"
      },
      "Nice": {
        "IsValid": true,
        "UserId": "nice-dev-user-001",
        "Email": "dev.agent@nice.com",
        "FirstName": "Dev",
        "LastName": "NiceAgent"
      },
      "Anon": {
        "IsValid": true,
        "UserId": "anon-dev-user-001",
        "Email": "dev.anon@example.com",
        "FirstName": "Dev",
        "LastName": "AnonUser",
        "SurveyId": "dev-survey-001"
      }
    }
  },
  "Applications": {
    "SurveyPortal": {
      "AuthProvider": "ANON",
      "External": {
        "ChatMode": "BotThenHuman",
        "CanShareScreen": true,
        "NeedScreenRecording": false
      },
      "Internal": {
        "ChatMode": "TalkWithAvailableAgent",
        "CanShareScreen": true,
        "NeedScreenRecording": false
      },
      "Agent": {
        "CanHandOffToOtherAgent": true,
        "MaxParallelChats": 5
      },
      "Supervisor": {
        "MaxParallelChats": 10,
        "CanHandOffToOtherAgent": false
      },
      "StandAlone": {
        "AutoRecordScreen": true,
        "SupervisorCanWatchLive": false
      }
    },
    "CustomerSupport": {
      "AuthProvider": "READI",
      "External": {
        "ChatMode": "BotThenHuman",
        "CanShareScreen": true,
        "NeedScreenRecording": true
      },
      "Internal": {
        "ChatMode": "TalkWithAvailableAgent",
        "CanShareScreen": true,
        "NeedScreenRecording": false
      },
      "Agent": {
        "CanHandOffToOtherAgent": true,
        "MaxParallelChats": 8
      },
      "Supervisor": {
        "MaxParallelChats": 15,
        "CanHandOffToOtherAgent": true
      },
      "StandAlone": {
        "AutoRecordScreen": false,
        "SupervisorCanWatchLive": true
      }
    },
    "NicePortal": {
      "AuthProvider": "NICE",
      "External": {
        "ChatMode": "OnlyHuman",
        "CanShareScreen": false,
        "NeedScreenRecording": false
      },
      "Internal": {
        "ChatMode": "TalkWithAvailableAgent",
        "CanShareScreen": true,
        "NeedScreenRecording": true
      },
      "Agent": {
        "CanHandOffToOtherAgent": false,
        "MaxParallelChats": 3
      },
      "Supervisor": {
        "MaxParallelChats": 20,
        "CanHandOffToOtherAgent": false
      },
      "StandAlone": {
        "AutoRecordScreen": true,
        "SupervisorCanWatchLive": true
      }
    }
  }
}
